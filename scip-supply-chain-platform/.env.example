# ---- copy to .env and fill in; NEVER commit real keys ----
DATABASE_URL=postgresql+psycopg2://scip:scip@localhost:5432/scip
LOG_LEVEL=INFO
ENVIRONMENT=development

# Dataset folders (defaults: data/raw/<name>); set to your kagglehub download paths if you prefer
# OLIST_DIR=C:/Users/you/.cache/kagglehub/datasets/olistbr/brazilian-ecommerce/versions/2
# DATACO_DIR=C:/Users/you/.cache/kagglehub/datasets/shashwatwork/dataco-smart-supply-chain-for-big-data-analysis/versions/1
PLANNING_SKU_COUNT=150

# External APIs (no keys needed for Open-Meteo / REST Countries)
ENABLE_EXTERNAL_APIS=true

# LLM for the Copilot: anthropic | openai | none
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# n8n: webhook that receives platform events (approval requests, cycle summaries)
N8N_WEBHOOK_URL=
API_BASE_URL=http://localhost:8000
# Optional: require X-API-Key on mutating API calls
API_KEY=

AUTO_APPROVE_LIMIT=2500
MANAGER_APPROVE_LIMIT=25000

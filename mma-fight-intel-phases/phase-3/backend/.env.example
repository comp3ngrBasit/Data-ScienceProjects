# Copy to backend/.env to override defaults. All variables are optional.

# Where videos, thumbnails, frames, previews, logs and the SQLite DB are stored.
# MMA_DATA_DIR=D:/FightData

# Explicit FFmpeg binaries (otherwise PATH, then the bundled imageio-ffmpeg binary is used)
# MMA_FFMPEG_PATH=C:/ffmpeg/bin/ffmpeg.exe
# MMA_FFPROBE_PATH=C:/ffmpeg/bin/ffprobe.exe

# Number of background processing workers
# MMA_WORKER_THREADS=1

# MMA_LOG_LEVEL=INFO
